# Servidor Webhooks
HOST=127.0.0.1
PORT=3007
WEBHOOK_SECRET=replace_with_strong_random_secret
WEBHOOK_BODY_LIMIT=10mb
DATABASE_PATH=./sessions.sqlite
TZ=America/Asuncion

# ERP Urutau (Studio Ferreira)
URUTAU_API_URL=https://studioferreira.codeart.com.py/api/v1
URUTAU_API_KEY=your_urutau_api_key_here
DEFAULT_SERVICIO_ID=1

# Evolution API v2 (WhatsApp)
EVOLUTION_API_URL=https://your-evolution-api-url
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_INSTANCE_NAME=studio-ferreira

# Inteligência Artificial (escolha pelo menos 1 provedor: gemini, openai ou groq)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternativa OpenAI / Compatível (ex.: roteando pelo Headroom Proxy local)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# AI_BASE_URL=http://127.0.0.1:8787/v1

# Alternativa Groq (Whisper ultra-rápido + Llama)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Alertas Telegram (Admin)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Guardrails e Debounce
DEBOUNCE_MS=3500
MAX_TEXT_CHARS=600
MAX_AUDIO_SECONDS=60
RATE_LIMIT_PER_MIN=8
RATE_LIMIT_PER_HOUR=35
